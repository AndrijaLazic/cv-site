# ── Container ────────────────────────────────────────────────────────────────
# Name of the Docker container.
CONTAINER_NAME=tanstack-app

# ── Network ───────────────────────────────────────────────────────────────────
# Host interface to bind on. Use 127.0.0.1 to accept only local (Nginx proxy)
# traffic, or 0.0.0.0 to expose the container directly (not recommended).
BIND_HOST=127.0.0.1

# Port published on the host machine.
HOST_PORT=3000

# ── Application ───────────────────────────────────────────────────────────────
# Host and port the Node server listens on inside the container.
APP_HOST=0.0.0.0
APP_PORT=3000

NODE_ENV=production
